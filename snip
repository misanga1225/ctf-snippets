#!/usr/bin/env python3
"""snip - ctf-snippets のスクリプトを一覧・検索・表示する CLI。

各スクリプト冒頭の `# @desc:` / `# @tags:` / `# @deps:` / `# @usage:` ヘッダを読み取る。
（C / JavaScript / Java では `// @desc:` のように `//` コメントで書く）
"""
import argparse
import os
import re
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent
EXTS = {".py", ".sh", ".c", ".js", ".java"}
HEADER_RE = re.compile(r"^(?:#|//)\s*@(\w+):\s*(.*)$")
README = ROOT / "README.md"
START, END = "<!-- SNIPPETS:START -->", "<!-- SNIPPETS:END -->"

# README とリスト表示でのカテゴリ表示名（ディレクトリ → 見出し）
CATEGORY_TITLES = {
    "encoding": "🔤 encoding — エンコード / デコード",
    "network/pcap": "📦 network/pcap — パケットキャプチャ解析",
    "network/recon": "🛰️ network/recon — 偵察・ネットワーク計算",
    "reversing/surface": "🔍 reversing/surface — 表層解析",
    "reversing/static": "🧩 reversing/static — 静的解析・パッチ",
    "reversing/dynamic": "🐞 reversing/dynamic — 動的解析",
    "reversing/solve": "🧮 reversing/solve — シンボリック実行・ソルバ",
    "soc": "🛡️ soc — NOC/SOC 運用・ログ解析",
}

USE_COLOR = sys.stdout.isatty()


def c(text, code):
    return f"\033[{code}m{text}\033[0m" if USE_COLOR else text


def parse_header(path):
    meta = {"desc": "", "tags": "", "deps": "none", "usage": ""}
    with path.open(encoding="utf-8", errors="replace") as f:
        for i, line in enumerate(f):
            if i > 30:
                break
            m = HEADER_RE.match(line.strip())
            if m and m.group(1) in meta:
                meta[m.group(1)] = m.group(2).strip()
    return meta


def collect():
    snippets = []
    for path in sorted(ROOT.rglob("*")):
        if path.suffix not in EXTS or not path.is_file():
            continue
        rel = path.relative_to(ROOT)
        if any(part.startswith(".") for part in rel.parts):
            continue
        meta = parse_header(path)
        if not meta["desc"]:
            continue
        meta["path"] = rel.as_posix()
        meta["name"] = path.name
        meta["category"] = rel.parent.as_posix()
        snippets.append(meta)
    return snippets


def category_key(cat):
    order = list(CATEGORY_TITLES)
    return (order.index(cat) if cat in order else 99, cat)


def print_rows(snippets):
    current = None
    for s in sorted(snippets, key=lambda s: (category_key(s["category"]), s["path"])):
        if s["category"] != current:
            current = s["category"]
            print(c(f"\n[{current}]", "1;36"))
        print(f"  {c(s['path'], '33'):<40}  {s['desc']}")


def cmd_list(args):
    snippets = collect()
    if args.category:
        snippets = [s for s in snippets if s["category"].startswith(args.category)]
    if not snippets:
        sys.exit(f"no snippets in category: {args.category}")
    print_rows(snippets)


def cmd_search(args):
    words = [w.lower() for w in args.keywords]
    hits = [
        s for s in collect()
        if all(w in " ".join((s["path"], s["desc"], s["tags"])).lower() for w in words)
    ]
    if not hits:
        sys.exit("no match")
    print_rows(hits)


def find_one(name):
    matches = [s for s in collect() if name in (s["name"], s["path"], Path(s["name"]).stem)]
    if not matches:
        matches = [s for s in collect() if name in s["path"]]
    if len(matches) != 1:
        cands = ", ".join(s["path"] for s in matches) or "none"
        sys.exit(f"'{name}' に一致するスクリプトが {len(matches)} 件です: {cands}")
    return matches[0]


def cmd_show(args):
    s = find_one(args.name)
    if args.cat:
        sys.stdout.write((ROOT / s["path"]).read_text(encoding="utf-8"))
        return
    print(c(s["path"], "1;33"))
    print(f"  desc : {s['desc']}")
    print(f"  tags : {s['tags']}")
    print(f"  deps : {s['deps']}")
    print(f"  usage: {s['usage']}")


def cmd_path(args):
    print(ROOT / find_one(args.name)["path"])


def render_table(scope=""):
    """scope（ROOT からの相対ディレクトリ）配下のスクリプト表を生成。リンクは README からの相対パス。
    ルート README は概要なので「スクリプト / 用途」だけの簡易表、各分野の README は依存・使用例つき"""
    compact = not scope
    out = []
    groups = {}
    for s in collect():
        if scope and not (s["category"] == scope or s["category"].startswith(scope + "/")):
            continue
        groups.setdefault(s["category"], []).append(s)
    for cat in sorted(groups, key=category_key):
        title = CATEGORY_TITLES.get(cat, cat)
        if compact and (ROOT / cat / "README.md").exists():
            title += f"（詳細: [{cat}/README.md]({cat}/README.md)）"
        out.append(f"### {title}\n")
        out.append("| スクリプト | 用途 |" if compact else "| スクリプト | 用途 | 依存 | 使用例 |")
        out.append("|---|---|" if compact else "|---|---|---|---|")
        for s in groups[cat]:
            usage = s["usage"].replace("|", "\\|")
            link = os.path.relpath(s["path"], scope or ".")
            if compact:
                out.append(f"| [`{s['name']}`]({link}) | {s['desc']} |")
            else:
                out.append(f"| [`{s['name']}`]({link}) | {s['desc']} | {s['deps']} | `{usage}` |")
        out.append("")
    return "\n".join(out)


def readme_files():
    """マーカーを含む README.md（ルート + 各分野ディレクトリ）"""
    files = [README] + sorted(p for p in ROOT.rglob("README.md") if p != README)
    return [p for p in files
            if not any(part.startswith(".") for part in p.relative_to(ROOT).parts)
            and START in p.read_text(encoding="utf-8")]


def cmd_readme(args):
    stale = []
    for path in readme_files():
        text = path.read_text(encoding="utf-8")
        head, rest = text.split(START, 1)
        if END not in rest:
            sys.exit(f"{path.relative_to(ROOT)} に {END} マーカーがありません")
        _, tail = rest.split(END, 1)
        scope = path.parent.relative_to(ROOT).as_posix()
        new = f"{head}{START}\n\n{render_table('' if scope == '.' else scope)}\n{END}{tail}"
        if new == text:
            continue
        stale.append(path.relative_to(ROOT).as_posix())
        if not args.check:
            path.write_text(new, encoding="utf-8")
    if args.check:
        if stale:
            sys.exit("スクリプト一覧が古い README があります: " + ", ".join(stale) + "\n`./snip readme` を実行してください")
        print("all README files are up to date")
    elif stale:
        print("一覧を更新しました: " + ", ".join(stale))
    else:
        print("変更なし（すべて最新）")


def main():
    p = argparse.ArgumentParser(prog="snip", description="ctf-snippets の一覧・検索・表示")
    sub = p.add_subparsers(dest="cmd", required=True)

    sp = sub.add_parser("list", aliases=["ls"], help="カテゴリ別に一覧表示")
    sp.add_argument("category", nargs="?", help="例: encoding, network, soc, reversing/static")
    sp.set_defaults(func=cmd_list)

    sp = sub.add_parser("search", aliases=["s"], help="説明・タグ・パスを AND 検索")
    sp.add_argument("keywords", nargs="+")
    sp.set_defaults(func=cmd_search)

    sp = sub.add_parser("show", help="usage / 依存を表示 (--cat で本文)")
    sp.add_argument("name", help="ファイル名・拡張子なし名・パスのいずれか")
    sp.add_argument("--cat", action="store_true", help="スクリプト本文を出力（コピペ用）")
    sp.set_defaults(func=cmd_show)

    sp = sub.add_parser("path", help="スクリプトの絶対パスを出力（$(snip path b64) 用）")
    sp.add_argument("name")
    sp.set_defaults(func=cmd_path)

    sp = sub.add_parser("readme", help="README.md（ルート + 各分野）のスクリプト一覧表を再生成")
    sp.add_argument("--check", action="store_true", help="更新が必要なら非0で終了")
    sp.set_defaults(func=cmd_readme)

    args = p.parse_args()
    args.func(args)


if __name__ == "__main__":
    main()

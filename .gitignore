__pycache__/
*.pyc
.venv/
.DS_Store

# 解析対象のキャプチャはコミットしない
*.pcap
*.pcapng
*.cap

# スクリプトの出力物
# extract_http.sh の出力先 (default)
out/
# follow_tcp.sh の出力先 (default)
streams/
# nmap_quick.sh の出力 (.nmap/.gnmap/.xml)
nmap_*.nmap
nmap_*.gnmap
nmap_*.xml

# 実データのログ・解析結果（認証ログやアクセスログには個人情報・IP が含まれる）
*.log
*.log.*
*.gz
*.csv
*.bin

# reversing の出力物
# patch_bytes.py の出力 (default: <file>.patched)
*.patched
# ld_preload_hook.c のビルド結果
*.so
# embedded_scan.py -x / binwalk の出力
carved/
_*.extracted/
# ghidra_decompile.sh の出力 (default: <binary>.c) は名前が様々なので必要に応じて追加
